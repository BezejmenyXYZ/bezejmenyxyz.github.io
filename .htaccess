# Bezejmeny.xyz domain routing configuration  
# This htaccess should be placed in the root of bezejmeny.xyz (GitHub Pages)

RewriteEngine On

# Simplified redirect rules for better GitHub Pages compatibility
# Admin section redirect
RewriteRule ^admin/?(.*)$ https://bezejmeny.online/admin/$1 [R=301,L]

# Register section redirect  
RewriteRule ^register/?(.*)$ https://bezejmeny.online/register/$1 [R=301,L]

# Founders section redirect
RewriteRule ^founders/?(.*)$ https://bezejmeny.online/founders/$1 [R=301,L]

# API section redirect
RewriteRule ^api/?(.*)$ https://bezejmeny.online/api/$1 [R=301,L]

# Allow all other content to be served normally from .xyz
# (static HTML, CSS, JS, images, etc.)